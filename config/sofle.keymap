/*
 * Neovim-oriented, Miryoku-inspired Sofle keymap (v1, conservative). Layout rationale: docs/LAYOUT.md
 * The seller's original is kept in docs/reference/sofle.keymap.seller (and git tag baseline-upstream-bbd2a24).
 *
 * v1 rules: QWERTY, native hjkl, number row kept, NO hold-taps / combos / home-row mods, so Vim sequences
 * (dd, ciw, gg, Ctrl-w) behave like on a plain keyboard.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define SYS 3

/ {
    // Hold NAV (left thumb) + SYM (right thumb) together to get SYS (function keys, Bluetooth, RGB, recovery)

    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys_trigger {
            if-layers = <NAV SYM>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "base";

            // ----------------------------------------------------------------------------------------------------
            // |  `   |  1   |  2   |  3   |  4   |  5   |              |  6   |  7   |  8   |  9   |  0   |  -   |
            // | TAB  |  Q   |  W   |  E   |  R   |  T   |              |  Y   |  U   |  I   |  O   |  P   |  =   |
            // | ESC  |  A   |  S   |  D   |  F   |  G   |              |  H   |  J   |  K   |  L   |  ;   |  '   |
            // |SHIFT |  Z   |  X   |  C   |  V   |  B   | MUTE |      |  N   |  M   |  ,   |  .   |  /   |SHIFT |
            //        | GUI  | NAV  | ALT  | CTRL |SPACE |              |ENTER | BSPC | SYM  |  \   | ALT  |

            bindings = <
&kp GRAVE   &kp N1      &kp N2      &kp N3      &kp N4      &kp N5                              &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp MINUS
&kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T                               &kp Y       &kp U       &kp I       &kp O       &kp P       &kp EQUAL
&kp ESC     &kp A       &kp S       &kp D       &kp F       &kp G                               &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp SQT
&kp LSHFT   &kp Z       &kp X       &kp C       &kp V       &kp B       &kp C_MUTE  &none       &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp RSHFT
            &kp LGUI    &mo NAV     &kp LALT    &kp LCTRL   &kp SPACE                           &kp ENTER   &kp BSPC    &mo SYM     &kp BSLH    &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            display-name = "nav";

            // Hold left-thumb NAV. Right hand: arrows on h j k l, paging on the row above.
            // Left home row: plain GUI/ALT/CTRL/SHIFT (hold one, press an arrow). '.' = passes through to base, blank = disabled.
            // ----------------------------------------------------------------------------------------------------
            // |  .   |  .   |  .   |  .   |  .   |  .   |              |  .   |  .   |  .   |  .   |  .   |  .   |
            // |  .   |      |      |      |      |      |              | HOME | PGDN | PGUP | END  |      |  .   |
            // |  .   | GUI  | ALT  | CTRL |SHIFT |      |              |  <-  |  v   |  ^   |  ->  |      |  .   |
            // |  .   |      |      |      |      |      |  .   |  .   |      |      |      |      |      |  .   |
            //        |  .   |  .   |  .   |  .   |  .   |              |  .   |  .   |  .   | DEL  |  .   |

            bindings = <
&trans     &trans     &trans     &trans     &trans     &trans                           &trans     &trans     &trans     &trans     &trans     &trans
&trans     &none      &none      &none      &none      &none                            &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &none      &trans
&trans     &kp LGUI   &kp LALT   &kp LCTRL  &kp LSHFT  &none                            &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &none      &trans
&trans     &none      &none      &none      &none      &none      &trans     &trans     &none      &none      &none      &none      &none      &trans
           &trans     &trans     &trans     &trans     &trans                           &trans     &trans     &trans     &kp DEL    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        sym_layer {
            display-name = "sym";

            // Hold right-thumb SYM. Left hand = Miryoku symbols (the *shifted* numpad block), right hand = the same
            // block *unshifted* (digits + [ ] ; = \ `). Left thumbs: ) and _ . '.' = passes through to base, blank = disabled.
            // ----------------------------------------------------------------------------------------------------
            // |  .   |  .   |  .   |  .   |  .   |  .   |              |  .   |  .   |  .   |  .   |  .   |  .   |
            // |  .   |  {   |  &   |  *   |  (   |  }   |              |  [   |  7   |  8   |  9   |  ]   |  .   |
            // |  .   |  :   |  $   |  %   |  ^   |  +   |              |  ;   |  4   |  5   |  6   |  =   |  .   |
            // |  .   |  ~   |  !   |  @   |  #   |  |   |  .   |  .   |  `   |  1   |  2   |  3   |  \   |  .   |
            //        |  .   |  .   |  .   |  )   |  _   |              |  .   |  .   |  .   |  .   |  .   |

            bindings = <
&trans     &trans     &trans     &trans     &trans     &trans                           &trans     &trans     &trans     &trans     &trans     &trans
&trans     &kp LBRC   &kp AMPS   &kp STAR   &kp LPAR   &kp RBRC                         &kp LBKT   &kp N7     &kp N8     &kp N9     &kp RBKT   &trans
&trans     &kp COLON  &kp DLLR   &kp PRCNT  &kp CARET  &kp PLUS                         &kp SEMI   &kp N4     &kp N5     &kp N6     &kp EQUAL  &trans
&trans     &kp TILDE  &kp EXCL   &kp AT     &kp HASH   &kp PIPE   &trans     &trans     &kp GRAVE  &kp N1     &kp N2     &kp N3     &kp BSLH   &trans
           &trans     &trans     &trans     &kp RPAR   &kp UNDER                        &trans     &trans     &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        sys_layer {
            display-name = "sys";

            // NAV + SYM held together. F-keys on the number row, Bluetooth profiles, RGB / external power, and two recovery
            // keys in the bottom corners (hard to hit by accident):
            //   BOOT  = enter the UF2 bootloader on the half whose key you press (same as double-tapping reset)
            //   BTCLR = clear ONLY the currently selected Bluetooth profile's bond
            // ----------------------------------------------------------------------------------------------------
            // |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |              |  F7  |  F8  |  F9  | F10  | F11  | F12  |
            // |      | BT0  | BT1  | BT2  | BT3  | BT4  |              | RGB  | HUI  | SAI  | BRI  | EFF  |      |
            // | CAPS |EXTPW |      |      |      |      |              |      | HUD  | SAD  | BRD  |      |      |
            // | BOOT |      |      |      |      |      |      |      |      |      |      |      |      |BTCLR |
            //        |      |      |      |      |      |              |      |      |      |      |      |

            bindings = <
&kp F1             &kp F2             &kp F3             &kp F4             &kp F5             &kp F6                                                   &kp F7             &kp F8             &kp F9             &kp F10            &kp F11            &kp F12
&none              &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3       &bt BT_SEL 4                                             &rgb_ug RGB_TOG    &rgb_ug RGB_HUI    &rgb_ug RGB_SAI    &rgb_ug RGB_BRI    &rgb_ug RGB_EFF    &none
&kp CAPS           &ext_power EP_TOG  &none              &none              &none              &none                                                    &none              &rgb_ug RGB_HUD    &rgb_ug RGB_SAD    &rgb_ug RGB_BRD    &none              &none
&bootloader        &none              &none              &none              &none              &none              &none              &none              &none              &none              &none              &none              &none              &bt BT_CLR
                   &none              &none              &none              &none              &none                                                    &none              &none              &none              &none              &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
